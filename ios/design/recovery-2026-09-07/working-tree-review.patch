diff --git a/ios/LoriLocal/Services/TranscriptExport.swift b/ios/LoriLocal/Services/TranscriptExport.swift
new file mode 100644
index 0000000..b2a989f
--- /dev/null
+++ b/ios/LoriLocal/Services/TranscriptExport.swift
@@ -0,0 +1,252 @@
+import Foundation
+
+/// Расшифровка, готовая уйти наружу файлом.
+///
+/// Раньше «Поделиться» отдавало системному листу голую строку, и получатель
+/// вставлял её текстом в тело сообщения — вместе с разметкой Markdown, которая
+/// без Lori читается как мусор: `**[0:00–0:12]** S1: …`. Файл с расширением
+/// снимает это целиком: тип и кодировку получатель больше не угадывает, а имя
+/// файла человек видит до того, как его откроет.
+///
+/// Модель нарочно не знает ни про UIKit, ни про сторы: имена говорящих, тема и
+/// описание приходят готовыми значениями, поэтому её можно целиком проверить
+/// тестами.
+struct TranscriptExport: Sendable {
+    /// Абзац расшифровки — то же, что строка на экране записи, но метка
+    /// говорящего уже заменена именем: снаружи приложения кружков нет.
+    struct Block: Sendable, Equatable {
+        let start: TimeInterval?
+        let end: TimeInterval?
+        /// Время — границы отправленного куска, а не реплики. Пометка обязана
+        /// доехать до файла: выдать границы куска за таймкод речи значит соврать.
+        let isApproximate: Bool
+        let speaker: String?
+        let text: String
+
+        /// «0:12», «0:12–0:34» — как в файле расшифровки.
+        var range: String? {
+            guard let start else { return nil }
+            let from = TranscriptSegment.stamp(start)
+            guard let end, end > start else { return from }
+            return "\(from)–\(TranscriptSegment.stamp(end))"
+        }
+
+        /// Время с пометкой куска: «кусок 0:00–5:00».
+        var markedRange: String? {
+            guard let range else { return nil }
+            return isApproximate ? "кусок \(range)" : range
+        }
+    }
+
+    let title: String
+    let recordedAt: Date
+    let duration: TimeInterval?
+    /// Описание записи, придуманное моделью заголовков.
+    let detail: String?
+    let topic: String?
+    /// Полное имя движка, как оно записано в файле расшифровки.
+    let engine: String?
+    var mode: String? = nil
+    /// Замечания к расшифровке: пропущенные участки и срывы. В файл идут
+    /// обязательно — человек, получивший расшифровку, должен знать о дырах.
+    let warnings: [String]
+    let blocks: [Block]
+
+    var isEmpty: Bool { blocks.isEmpty }
+
+    /// Строка под заголовком: «27 августа 2026, 22:22 · 41:12 · тема: Работа».
+    var meta: String {
+        var parts = [Self.stampFormatter.string(from: recordedAt)]
+        if let duration, duration > 0 { parts.append(TranscriptSegment.stamp(duration)) }
+        if let topic, !topic.isEmpty { parts.append("тема: \(topic)") }
+        return parts.joined(separator: " · ")
+    }
+
+    // MARK: - Сборка
+
+    static func make(
+        document: TranscriptDocument,
+        title: String,
+        recordedAt: Date,
+        duration: TimeInterval? = nil,
+        detail: String? = nil,
+        topic: String? = nil,
+        names: [String: String] = [:]
+    ) -> TranscriptExport {
+        TranscriptExport(
+            title: title,
+            recordedAt: recordedAt,
+            // Длительность знает плеер, а он не всегда загружен. Тогда берём
+            // последнее настоящее время из расшифровки — оно короче записи, но
+            // это измеренное число, а не выдуманное.
+            duration: (duration ?? 0) > 0 ? duration : document.lastStamp,
+            detail: detail,
+            topic: topic,
+            engine: document.engine,
+            mode: document.mode,
+            warnings: document.warnings,
+            blocks: document.lines.map { line in
+                Block(
+                    start: line.start,
+                    end: line.end,
+                    isApproximate: line.isApproximate,
+                    speaker: line.speaker.map { names[$0] ?? $0 },
+                    text: line.text
+                )
+            }
+        )
+    }
+
+    /// Вход из списка записей: там расшифровка ещё не разобрана, на руках
+    /// только текст файла.
+    static func make(
+        markdown: String,
+        title: String,
+        recordedAt: Date,
+        duration: TimeInterval? = nil,
+        detail: String? = nil,
+        topic: String? = nil,
+        names: [String: String] = [:]
+    ) -> TranscriptExport {
+        make(
+            document: TranscriptDocument.parse(markdown),
+            title: title,
+            recordedAt: recordedAt,
+            duration: duration,
+            detail: detail,
+            topic: topic,
+            names: names
+        )
+    }
+
+    // MARK: - Markdown
+
+    /// Тот же костяк, что пишет `Transcript.markdown` в файл расшифровки, плюс
+    /// то, чего в файле нет: дата, длительность, тема и описание записи. Файл —
+    /// это текст записи, а экспорт человек читает отдельно от приложения, и
+    /// шапка ему нужна.
+    var markdown: String {
+        var parts = ["# \(title)", "_\(meta)_"]
+        if let detail, !detail.isEmpty { parts.append(detail) }
+        if let engine, !engine.isEmpty { parts.append("_Расшифровано: \(engine)_") }
+        if let mode, !mode.isEmpty { parts.append("_Режим: \(mode)_") }
+        if !warnings.isEmpty { parts.append(warnings.map { "> \($0)" }.joined(separator: "\n")) }
+        parts.append(contentsOf: blocks.map(Self.markdownBlock))
+        return parts.joined(separator: "\n\n") + "\n"
+    }
+
+    private static func markdownBlock(_ block: Block) -> String {
+        let text = block.speaker.map { "\($0): \(block.text)" } ?? block.text
+        guard let range = block.markedRange else { return text }
+        return "**[\(range)]** \(text)"
+    }
+
+    // MARK: - Имя файла
+
+    func filename(for format: TranscriptExportFormat) -> String {
+        "\(Self.safeName(title)).\(format.fileExtension)"
+    }
+
+    /// Имя файла видит получатель, поэтому берём заголовок записи, а не
+    /// служебное `lori-20260904-slug`. Двоеточие из «Запись 22:22» и слэши
+    /// файловая система не примет.
+    static func safeName(_ title: String) -> String {
+        let forbidden = CharacterSet(charactersIn: "/\\:*?\"<>|")
+            .union(.controlCharacters)
+            .union(.newlines)
+        let clean = title.components(separatedBy: forbidden)
+            .joined(separator: " ")
+            .split(separator: " ", omittingEmptySubsequences: true)
+            .joined(separator: " ")
+        let cut = String(clean.prefix(60)).trimmingCharacters(in: .whitespaces)
+        // Точка первым знаком делает файл скрытым, пустое имя — безымянным.
+        return cut.isEmpty || cut.hasPrefix(".") ? "Расшифровка" : cut
+    }
+
+    /// Дата абсолютная: `LoriFormat.stamp` для сегодняшней записи даёт одно
+    /// время, а файл переживёт этот день.
+    private static let stampFormatter: DateFormatter = {
+        let formatter = DateFormatter()
+        formatter.locale = LoriFormat.locale
+        formatter.dateFormat = "d MMMM yyyy, HH:mm"
+        return formatter
+    }()
+}
+
+/// Формат экспорта. Формулировки те же, что в веб-интерфейсе Lori: продукт один,
+/// и «Markdown (.md)» на телефоне не должен называться иначе, чем на Маке.
+enum TranscriptExportFormat: String, CaseIterable, Identifiable, Sendable {
+    case pdf
+    case markdown
+
+    var id: String { rawValue }
+
+    var title: String {
+        switch self {
+        case .pdf: "PDF"
+        case .markdown: "Markdown (.md)"
+        }
+    }
+
+    var note: String {
+        switch self {
+        case .pdf: "Удобно читать и отправлять"
+        case .markdown: "Текст для дальнейшей работы"
+        }
+    }
+
+    var icon: String {
+        switch self {
+        case .pdf: "doc.richtext"
+        case .markdown: "doc.plaintext"
+        }
+    }
+
+    var fileExtension: String {
+        switch self {
+        case .pdf: "pdf"
+        case .markdown: "md"
+        }
+    }
+}
+
+extension TranscriptExport {
+    /// Файл для листа «Поделиться». PDF считается вне главного актора: часовая
+    /// расшифровка — это десятки страниц вёрстки, и кнопка не должна на них
+    /// подвисать.
+    func file(as format: TranscriptExportFormat) async throws -> URL {
+        let name = filename(for: format)
+        switch format {
+        case .markdown:
+            return try TranscriptExportFile.write(Data(markdown.utf8), name: name)
+        case .pdf:
+            let export = self
+            let data = await Task.detached(priority: .userInitiated) {
+                TranscriptPDF.data(for: export)
+            }.value
+            return try TranscriptExportFile.write(data, name: name)
+        }
+    }
+}
+
+/// Куда ложится экспорт.
+enum TranscriptExportFile {
+    static var directory: URL {
+        FileManager.default.temporaryDirectory
+            .appending(path: "LoriExport", directoryHint: .isDirectory)
+    }
+
+    /// Папка чистится **перед** записью, а не после закрытия листа: часть
+    /// получателей — «Сохранить в Файлы», например — читает файл уже после
+    /// того, как лист закрылся, и уборка «на выходе» выдёргивала бы файл
+    /// из-под них. Рабочая папка для экспорта не годится вовсе: она видна
+    /// в «Файлах», и служебные копии там были бы мусором рядом с записями.
+    static func write(_ data: Data, name: String) throws -> URL {
+        let manager = FileManager.default
+        try? manager.removeItem(at: directory)
+        try manager.createDirectory(at: directory, withIntermediateDirectories: true)
+        let url = directory.appending(path: name)
+        try data.write(to: url, options: .atomic)
+        return url
+    }
+}
diff --git a/ios/LoriLocal/Services/TranscriptPDF.swift b/ios/LoriLocal/Services/TranscriptPDF.swift
new file mode 100644
index 0000000..c89e51d
--- /dev/null
+++ b/ios/LoriLocal/Services/TranscriptPDF.swift
@@ -0,0 +1,280 @@
+import CoreText
+import UIKit
+
+/// Расшифровка страницами A4.
+///
+/// PDF — это то, что откроется у любого получателя без вопросов о формате;
+/// поэтому он и стоит первым в меню «Поделиться». Вёрстка повторяет экспорт
+/// веб-интерфейса Lori (поля 21/18 мм, заголовок Georgia): продукт один, и
+/// лист, присланный с телефона, не должен выглядеть чужим рядом с листом с Мака.
+enum TranscriptPDF {
+    /// A4 в точках.
+    static let pageSize = CGSize(width: 595.28, height: 841.89)
+    /// 18 мм по бокам, 21 мм сверху и снизу — как в вебе.
+    static let sideMargin: CGFloat = 51
+    static let verticalMargin: CGFloat = 59.5
+    /// Воздух между шапкой, линией под ней и текстом.
+    static let ruleGap: CGFloat = 12
+
+    // MARK: - Цвета
+    //
+    // Палитра приложения динамическая: `LoriPalette.ink` в тёмной теме почти
+    // белый. Внутри рендера тема телефона никак не связана с бумагой, и лист,
+    // сделанный вечером, вышел бы белым по белому. Поэтому здесь свои цвета,
+    // и страница белая, а не кремовая: кремовый холст — язык экрана, на печати
+    // он съедает тонер. Оливковая линия под шапкой — единственный акцент.
+
+    private static let ink = UIColor(red: 0.12, green: 0.12, blue: 0.11, alpha: 1)
+    private static let muted = UIColor(red: 0.44, green: 0.44, blue: 0.41, alpha: 1)
+    private static let lime = UIColor(red: 0.36, green: 0.47, blue: 0, alpha: 1)
+    private static let warn = UIColor(red: 0.62, green: 0.44, blue: 0.05, alpha: 1)
+
+    static func data(for export: TranscriptExport) -> Data {
+        let format = UIGraphicsPDFRendererFormat()
+        format.documentInfo = [
+            kCGPDFContextTitle as String: export.title,
+            kCGPDFContextCreator as String: "Lori",
+        ]
+        let renderer = UIGraphicsPDFRenderer(
+            bounds: CGRect(origin: .zero, size: pageSize),
+            format: format
+        )
+
+        let header = header(for: export)
+        let body = body(for: export)
+        let contentWidth = pageSize.width - sideMargin * 2
+        let headerHeight = ceil(header.boundingRect(
+            with: CGSize(width: contentWidth, height: .greatestFiniteMagnitude),
+            options: [.usesLineFragmentOrigin, .usesFontLeading],
+            context: nil
+        ).height)
+
+        // Шапка живёт вне текстового потока: только так под ней можно провести
+        // линию, не угадывая, где именно поток кончился.
+        func column(page: Int) -> CGRect {
+            let top = page == 0 ? verticalMargin + headerHeight + ruleGap * 2 : verticalMargin
+            return CGRect(
+                x: sideMargin,
+                y: top,
+                width: contentWidth,
+                height: pageSize.height - verticalMargin - top
+            )
+        }
+
+        let framesetter = CTFramesetterCreateWithAttributedString(body)
+        let pages = pageRanges(framesetter, length: body.length, column: column)
+
+        return renderer.pdfData { context in
+            for (index, range) in pages.enumerated() {
+                context.beginPage()
+                if index == 0 {
+                    header.draw(
+                        with: CGRect(
+                            x: sideMargin,
+                            y: verticalMargin,
+                            width: contentWidth,
+                            height: headerHeight
+                        ),
+                        options: [.usesLineFragmentOrigin, .usesFontLeading],
+                        context: nil
+                    )
+                    let line = CGRect(
+                        x: sideMargin,
+                        y: verticalMargin + headerHeight + ruleGap,
+                        width: contentWidth,
+                        height: 0.8
+                    )
+                    lime.setFill()
+                    context.cgContext.fill(line)
+                }
+                if range.length > 0 {
+                    let cg = context.cgContext
+                    cg.saveGState()
+                    // CoreText считает от левого нижнего угла, UIKit — от левого
+                    // верхнего. Без переворота текст встаёт зеркально.
+                    cg.translateBy(x: 0, y: pageSize.height)
+                    cg.scaleBy(x: 1, y: -1)
+                    // Текстовая матрица **не входит в графическое состояние**:
+                    // `saveGState`/`restoreGState` её не возвращают, и та,
+                    // которую оставил после себя `CTFrameDraw`, доставалась
+                    // следующей странице. Отсюда живой отчёт с телефона: первая
+                    // страница верна, а все следующие зеркальны.
+                    cg.textMatrix = .identity
+                    let frame = CTFramesetterCreateFrame(framesetter, range, path(for: column(page: index)), nil)
+                    CTFrameDraw(frame, cg)
+                    cg.restoreGState()
+                }
+                if pages.count > 1 { drawFooter(page: index + 1, of: pages.count) }
+            }
+        }
+    }
+
+    // MARK: - Разбивка на страницы
+
+    /// Куски текста по страницам считаются заранее — иначе в подписи не написать
+    /// «из пяти», а «стр. 3» без общего числа не говорит, кончился ли документ.
+    private static func pageRanges(
+        _ framesetter: CTFramesetter,
+        length: Int,
+        column: (Int) -> CGRect
+    ) -> [CFRange] {
+        guard length > 0 else { return [CFRange(location: 0, length: 0)] }
+        var ranges: [CFRange] = []
+        var start = 0
+        while start < length {
+            let frame = CTFramesetterCreateFrame(
+                framesetter,
+                CFRange(location: start, length: 0),
+                path(for: column(ranges.count)),
+                nil
+            )
+            let visible = CTFrameGetVisibleStringRange(frame)
+            // Ноль означал бы вечный цикл: страница, на которую ничего не влезло.
+            let taken = max(Int(visible.length), 1)
+            ranges.append(CFRange(location: start, length: taken))
+            start += taken
+        }
+        return ranges
+    }
+
+    private static func path(for rect: CGRect) -> CGPath {
+        let flipped = CGRect(
+            x: rect.minX,
+            y: pageSize.height - rect.maxY,
+            width: rect.width,
+            height: rect.height
+        )
+        let path = CGMutablePath()
+        path.addRect(flipped)
+        return path
+    }
+
+    private static func drawFooter(page: Int, of total: Int) {
+        let text = NSAttributedString(
+            string: "стр. \(page) из \(total)",
+            attributes: [
+                .font: UIFont.systemFont(ofSize: 8.5),
+                .foregroundColor: muted,
+            ]
+        )
+        let size = text.size()
+        text.draw(at: CGPoint(
+            x: (pageSize.width - size.width) / 2,
+            y: pageSize.height - verticalMargin + ruleGap
+        ))
+    }
+
+    // MARK: - Текст
+
+    private static func header(for export: TranscriptExport) -> NSAttributedString {
+        let result = NSMutableAttributedString()
+        result.append(NSAttributedString(
+            string: export.title + "\n",
+            // Georgia стоит в системе, отдельный файл шрифта не нужен.
+            attributes: attributes(
+                font: UIFont(name: "Georgia", size: 25) ?? .systemFont(ofSize: 25, weight: .semibold),
+                color: ink,
+                style: style(spacingAfter: 6)
+            )
+        ))
+        result.append(NSAttributedString(
+            string: export.meta + "\n",
+            attributes: attributes(
+                font: .systemFont(ofSize: 9.5),
+                color: muted,
+                style: style(spacingAfter: export.detail == nil ? 4 : 8)
+            )
+        ))
+        if let detail = export.detail, !detail.isEmpty {
+            result.append(NSAttributedString(
+                string: detail + "\n",
+                attributes: attributes(
+                    font: .systemFont(ofSize: 10.5),
+                    color: ink,
+                    style: style(lineSpacing: 3, spacingAfter: 6)
+                )
+            ))
+        }
+        if let engine = export.engine, !engine.isEmpty {
+            result.append(NSAttributedString(
+                string: "Расшифровано: \(engine)" + (export.mode.map { " · \($0)" } ?? "") + "\n",
+                attributes: attributes(
+                    font: .systemFont(ofSize: 9.5),
+                    color: muted,
+                    style: style(spacingAfter: export.warnings.isEmpty ? 0 : 8)
+                )
+            ))
+        }
+        // Замечания стоят в шапке, а не в конце: это свойство всей расшифровки,
+        // и человек, получивший файл, должен знать о дырах до того, как начнёт
+        // читать, а не после.
+        for (offset, warning) in export.warnings.enumerated() {
+            result.append(NSAttributedString(
+                string: warning + (offset == export.warnings.count - 1 ? "" : "\n"),
+                attributes: attributes(
+                    font: .systemFont(ofSize: 9.5),
+                    color: warn,
+                    style: style(lineSpacing: 2, spacingAfter: 2)
+                )
+            ))
+        }
+        return result
+    }
+
+    private static func body(for export: TranscriptExport) -> NSAttributedString {
+        let result = NSMutableAttributedString()
+        let paragraph = style(lineSpacing: 6, spacingAfter: 9)
+        for (offset, block) in export.blocks.enumerated() {
+            if let range = block.markedRange {
+                result.append(NSAttributedString(
+                    string: range + "  ",
+                    // Моноширинные цифры: иначе колонка времени пляшет.
+                    attributes: attributes(
+                        font: .monospacedDigitSystemFont(ofSize: 9, weight: .regular),
+                        color: muted,
+                        style: paragraph
+                    )
+                ))
+            }
+            if let speaker = block.speaker {
+                result.append(NSAttributedString(
+                    string: speaker + ": ",
+                    attributes: attributes(
+                        font: .systemFont(ofSize: 11, weight: .semibold),
+                        color: ink,
+                        style: paragraph
+                    )
+                ))
+            }
+            result.append(NSAttributedString(
+                string: block.text + (offset == export.blocks.count - 1 ? "" : "\n"),
+                attributes: attributes(font: .systemFont(ofSize: 11), color: ink, style: paragraph)
+            ))
+        }
+        return result
+    }
+
+    /// Цвет проставляется двумя ключами. Шапку рисует UIKit и читает
+    /// `.foregroundColor`, а текст — CoreText, и у него для цвета свой ключ с
+    /// `CGColor`. С одним ключом половина документа выходила бы чёрной по
+    /// умолчанию, независимо от задуманного цвета.
+    private static func attributes(
+        font: UIFont,
+        color: UIColor,
+        style: NSParagraphStyle
+    ) -> [NSAttributedString.Key: Any] {
+        [
+            .font: font,
+            .foregroundColor: color,
+            NSAttributedString.Key(kCTForegroundColorAttributeName as String): color.cgColor,
+            .paragraphStyle: style,
+        ]
+    }
+
+    private static func style(lineSpacing: CGFloat = 0, spacingAfter: CGFloat) -> NSParagraphStyle {
+        let style = NSMutableParagraphStyle()
+        style.lineSpacing = lineSpacing
+        style.paragraphSpacing = spacingAfter
+        return style
+    }
+}
