<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.lori.tunnel</string>

  <!-- Обратный туннель на VPS: порт 22 проходит сквозь VPN, в отличие от 7844. -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/ssh</string>
    <string>-N</string>
    <string>-o</string><string>ExitOnForwardFailure=yes</string>
    <string>-o</string><string>ServerAliveInterval=30</string>
    <string>-o</string><string>ServerAliveCountMax=3</string>
    <string>-o</string><string>BatchMode=yes</string>
    <string>-R</string><string>127.0.0.1:4174:127.0.0.1:4173</string>
    <string>root@VPS_HOST</string>
  </array>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>15</integer>

  <key>StandardOutPath</key>
  <string>/path/to/Lori/logs/tunnel.out.log</string>
  <key>StandardErrorPath</key>
  <string>/path/to/Lori/logs/tunnel.err.log</string>
</dict>
</plist>
